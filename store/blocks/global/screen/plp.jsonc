{
    "store.search#global__store--search": {
        "title": "pagina global busqueda",
        "blocks": [
            "search-result-layout#global__search--result-layout"
        ],
        "props": {
            "context": {
                "skusFilter": "FIRST_AVAILABLE",
                "simulationBehavior": "default",
                "blockClass": [
                    "global__store--search"
                ]
            }
        }
    },
    "store.search#department": {
        "title": "busqueda departamentos",
        "blocks": [
