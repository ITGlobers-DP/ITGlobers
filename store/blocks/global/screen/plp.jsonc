    "search-result-layout#global__search--result-layout": {
        "title": "lista resultados",
        "props": {
            "blockClass": [
                "global__search--result-layout"
            ]
        },
        "blocks": [
            "search-result-layout.desktop#desktop__searh-result",
            "search-result-layout.mobile#mobile__searh-result",
            "search-not-found-layout"
